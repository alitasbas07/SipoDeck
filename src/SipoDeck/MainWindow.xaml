<Window x:Class="SipoDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SipoDeck.ViewModels"
        xmlns:views="clr-namespace:SipoDeck.Views"
        Style="{StaticResource SipoWindowStyle}"
        Title="SipoDeck"
        AutomationProperties.Name="SipoDeck"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- ViewModel → View eşlemesi -->
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfilesViewModel}">
            <views:ProfilesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderPageViewModel}">
            <views:PlaceholderView />
        </DataTemplate>

        <!-- Nav öğesi: ikon (IconKey → Geometry) ve başlık -->
        <Style x:Key="ShellNavItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource NavListBoxItemStyle}">
            <Setter Property="Tag" Value="{Binding IconKey, Converter={StaticResource ResourceKeyConverter}}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        </Style>

        <DataTemplate x:Key="ShellNavItemTemplate" DataType="{x:Type vm:NavigationItemViewModel}">
            <TextBlock Text="{Binding Title}" />
        </DataTemplate>

        <!-- Açılış → kabuk geçişi (design-system §10.g) -->
        <Storyboard x:Key="SplashExitStoryboard">
            <DoubleAnimation Storyboard.TargetName="Splash" Storyboard.TargetProperty="Opacity"
                             To="0" Duration="{StaticResource DurationSlow}"
                             EasingFunction="{StaticResource EaseOut}" />
        </Storyboard>
        <Storyboard x:Key="ShellEnterStoryboard">
            <DoubleAnimation Storyboard.TargetName="ShellRoot" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" BeginTime="0:0:0.08" Duration="{StaticResource DurationSlow}"
                             EasingFunction="{StaticResource EaseOutStrong}" />
            <DoubleAnimation Storyboard.TargetName="ShellRoot"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="8" To="0" BeginTime="0:0:0.08" Duration="{StaticResource DurationSlow}"
                             EasingFunction="{StaticResource EaseOutStrong}" />
        </Storyboard>

        <!-- Çalışma motoru göstergesi yalnızca Başlatılıyor / Durduruluyor iken görünür -->
        <Style x:Key="RuntimeBusyIndicatorStyle" TargetType="Control" BasedOn="{StaticResource StatusIndicatorStyle}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status.RuntimeState}" Value="Starting">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status.RuntimeState}" Value="Stopping">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="{StaticResource BgBaseBrush}">

        <!-- KABUK -->
        <Grid x:Name="ShellRoot" Visibility="Hidden" Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform />
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource NavColumnWidth}" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sol navigasyon -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="24,12,0,0" VerticalAlignment="Top" Height="16"
                            AutomationProperties.Name="SipoDeck">
                    <ContentControl Style="{StaticResource IconLogo16}" />
                    <TextBlock Style="{StaticResource TextWordmark}" Text="SipoDeck" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <ListBox Grid.Row="1"
                         Style="{StaticResource NavListBoxStyle}"
                         Margin="{StaticResource NavListMargin}"
                         ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource ShellNavItemStyle}"
                         ItemTemplate="{StaticResource ShellNavItemTemplate}"
                         AutomationProperties.Name="Gezinme" />

                <StackPanel Grid.Row="3">
                    <Rectangle Style="{StaticResource DividerHorizontalStyle}" Margin="24,0" />
                    <Grid Margin="{StaticResource NavFooterPadding}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <ContentControl Style="{StaticResource StatusLabelStyle}"
                                            Tag="{Binding Status.DeviceConnectionState}">
                                <TextBlock Style="{StaticResource TextBodySmallStrong}"
                                           Text="{Binding Status.DeviceName, TargetNullValue='Cihaz yok'}"
                                           ToolTip="{Binding Status.DeviceSummaryText}" />
                            </ContentControl>
                            <StackPanel Orientation="Horizontal" Margin="20,2,0,0">
                                <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Status.ConnectionStateText}" />
                                <TextBlock Style="{StaticResource TextCaption}"
                                           Text="{Binding Status.ConnectionTypeText, StringFormat=' · {0}'}"
                                           Visibility="{Binding Status.ConnectionTypeText, Converter={StaticResource NullToVisibilityConverter}}" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource TextCaptionMuted}" Text="Aktif profil" Margin="0,16,0,0" />
                            <TextBlock Style="{StaticResource TextBodySmall}" Text="{Binding Status.ActiveProfileName}" Margin="0,2,0,0" />

                            <TextBlock Style="{StaticResource TextCaptionMuted}" Text="Çalışma motoru" Margin="0,12,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Control Style="{StaticResource RuntimeBusyIndicatorStyle}" Tag="{Binding Status.RuntimeState}" />
                                <TextBlock Style="{StaticResource TextBodySmall}" Text="{Binding Status.RuntimeStateText}" />
                            </StackPanel>
                        </StackPanel>

                        <Button x:Name="SettingsShortcut" Grid.Column="1"
                                Style="{StaticResource IconButtonStyle}"
                                Tag="{StaticResource IconSettings}"
                                ToolTip="Ayarlar" AutomationProperties.Name="Ayarlar"
                                VerticalAlignment="Top" Margin="0,-7,0,0"
                                Click="OnSettingsShortcutClick" />
                    </Grid>
                </StackPanel>
            </Grid>

            <Rectangle Grid.Column="1" Style="{StaticResource DividerVerticalStyle}" />

            <!-- İçerik alanı -->
            <ContentControl Grid.Column="2"
                            Style="{StaticResource PageHostStyle}"
                            Content="{Binding CurrentPage, NotifyOnTargetUpdated=True}" />

            <!-- Kaydedilmemiş ayar uyarısı (içerik alanının üstünde) -->
            <views:UnsavedPromptView Grid.Column="2"
                Visibility="{Binding IsUnsavedPromptVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <!-- AÇILIŞ (kabuğun üstünde) -->
        <views:SplashView x:Name="Splash" />
    </Grid>
</Window>
