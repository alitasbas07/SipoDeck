<UserControl x:Class="SipoDeck.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">

    <UserControl.Resources>
        <!-- Alan hatası: alanın hemen altında, ikinci sıra metin; boşsa kaybolur. -->
        <Style x:Key="FieldErrorStyle" TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TextTitle3}">
            <Setter Property="Margin" Value="0,0,0,24" />
        </Style>

        <Style x:Key="OptionCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource QuietCheckBoxStyle}">
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style x:Key="OptionHintStyle" TargetType="TextBlock" BasedOn="{StaticResource TextCaptionMuted}">
            <Setter Property="Margin" Value="22,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
        </Style>

        <!-- Liste boşsa ipucu gösterilir -->
        <Style x:Key="NoPortsHintStyle" TargetType="TextBlock" BasedOn="{StaticResource TextCaptionMuted}">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PortNames.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BusyIndicatorStyle" TargetType="Control" BasedOn="{StaticResource StatusIndicatorStyle}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EmptyMappingsStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBodySecondary}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasNoFnMappings}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SavedMessageStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,20,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Başlık ve sabit eylemler -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Style="{StaticResource TextTitle1}" Text="Ayarlar" />
                <TextBlock Style="{StaticResource TextBodySecondary}" Margin="0,8,0,0"
                           Text="Bağlantı, uygulama ve girdi tercihlerini buradan düzenle." />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <StackPanel Style="{StaticResource SavedMessageStyle}"
                            Visibility="{Binding SavedMessage, Converter={StaticResource NullToVisibilityConverter}}">
                    <ContentControl Style="{StaticResource Icon16}" Content="{StaticResource IconCheck}" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource TextBodySmall}" Margin="8,0,0,0" VerticalAlignment="Center"
                               Text="{Binding SavedMessage}" />
                </StackPanel>
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="İptal"
                        Command="{Binding CancelCommand}" Margin="0,0,12,0" />
                <Button Style="{StaticResource PrimaryButtonStyle}" Content="Kaydet"
                        Command="{Binding SaveCommand}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <StackPanel MaxWidth="640" HorizontalAlignment="Left" Margin="0,0,24,24">

                <!-- Genel kayıt hatası -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,24"
                            Visibility="{Binding GeneralError, Converter={StaticResource NullToVisibilityConverter}}">
                    <ContentControl Style="{StaticResource Icon16}" Content="{StaticResource IconAlertCircle}" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <TextBlock Style="{StaticResource TextBodySmall}" Margin="8,0,0,0" MaxWidth="600"
                               TextWrapping="Wrap" TextTrimming="None" Text="{Binding GeneralError}" />
                </StackPanel>

                <!-- BAĞLANTI -->
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Bağlantı" />

                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Bağlantı türü" />
                <ComboBox Style="{StaticResource InputComboBoxStyle}" HorizontalAlignment="Left" Width="240"
                          SelectedIndex="{Binding ConnectionTypeIndex, Mode=TwoWay}"
                          AutomationProperties.Name="Bağlantı türü">
                    <ComboBoxItem Content="Wi-Fi" />
                    <ComboBoxItem Content="USB Serial" />
                </ComboBox>

                <!-- Wi-Fi alanları -->
                <StackPanel Margin="0,24,0,0"
                            Visibility="{Binding IsWiFi, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Cihaz adresi" />
                    <TextBox Style="{StaticResource InputTextBoxStyle}" HorizontalAlignment="Left" Width="320"
                             Text="{Binding Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Tag="{Binding HostError}" AutomationProperties.Name="Cihaz adresi" />
                    <TextBlock Style="{StaticResource FieldErrorStyle}" Text="{Binding HostError}" />

                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Port" Margin="0,24,0,8" />
                    <TextBox Style="{StaticResource InputTextBoxStyle}" HorizontalAlignment="Left" Width="160"
                             Text="{Binding PortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Tag="{Binding PortError}" AutomationProperties.Name="Port" />
                    <TextBlock Style="{StaticResource FieldErrorStyle}" Text="{Binding PortError}" />
                </StackPanel>

                <!-- USB Serial alanları -->
                <StackPanel Margin="0,24,0,0"
                            Visibility="{Binding IsSerial, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Seri port" />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Style="{StaticResource InputComboBoxStyle}" Width="240"
                                  ItemsSource="{Binding PortNames}"
                                  SelectedItem="{Binding SerialPortName, Mode=TwoWay}"
                                  Tag="{Binding SerialPortNameError}" AutomationProperties.Name="Seri port" />
                        <Button Style="{StaticResource IconButtonStyle}" Tag="{StaticResource IconRefresh}"
                                ToolTip="Listeyi yenile" AutomationProperties.Name="Listeyi yenile"
                                Command="{Binding RefreshPortsCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource NoPortsHintStyle}" Text="Seri port bulunamadı. Cihazı bağlayıp listeyi yenile." />
                    <TextBlock Style="{StaticResource FieldErrorStyle}" Text="{Binding SerialPortNameError}" />

                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Baud rate" Margin="0,24,0,8" />
                    <TextBox Style="{StaticResource InputTextBoxStyle}" HorizontalAlignment="Left" Width="160"
                             Text="{Binding BaudRateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Tag="{Binding BaudRateError}" AutomationProperties.Name="Baud rate" />
                    <TextBlock Style="{StaticResource FieldErrorStyle}" Text="{Binding BaudRateError}" />
                </StackPanel>

                <!-- Bağlantı durumu ve Şimdi bağlan -->
                <StackPanel Margin="0,32,0,0">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Durum" />
                    <ContentControl Style="{StaticResource StatusLabelStyle}" HorizontalAlignment="Left"
                                    Tag="{Binding Status.DeviceConnectionState}">
                        <TextBlock Style="{StaticResource TextBody}" Text="{Binding Status.ConnectionStateText}" />
                    </ContentControl>
                    <TextBlock Style="{StaticResource TextCaption}" Margin="20,4,0,0" Text="{Binding Status.DeviceSummaryText}" />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Şimdi bağlan"
                                Command="{Binding ConnectNowCommand}" />
                        <Control Style="{StaticResource BusyIndicatorStyle}" Tag="Busy" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource FieldErrorStyle}" Text="{Binding ConnectMessage}" />
                    <TextBlock Style="{StaticResource TextCaptionMuted}" Margin="0,8,0,0"
                               Text="Kaydedilmemiş değişiklikler varken kayıtlı ayarlarla bağlanılır."
                               Visibility="{Binding ConnectUsesSavedNote, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <Rectangle Style="{StaticResource DividerHorizontalStyle}" Margin="0,40" />

                <!-- UYGULAMA -->
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Uygulama" />

                <CheckBox Style="{StaticResource OptionCheckBoxStyle}" Content="Windows başlangıcında çalıştır"
                          IsChecked="{Binding RunAtStartup, Mode=TwoWay}" />
                <TextBlock Style="{StaticResource OptionHintStyle}" Text="Bilgisayar açıldığında SipoDeck kendiliğinden başlar." />

                <CheckBox Style="{StaticResource OptionCheckBoxStyle}" Content="Sistem tepsisinde çalış" Margin="0,20,0,0"
                          IsChecked="{Binding RunInSystemTray, Mode=TwoWay}" />
                <TextBlock Style="{StaticResource OptionHintStyle}" Text="Kapalıysa pencereyi kapatmak uygulamayı tamamen kapatır." />

                <CheckBox Style="{StaticResource OptionCheckBoxStyle}" Content="Otomatik yeniden bağlan" Margin="0,20,0,0"
                          IsChecked="{Binding AutoReconnect, Mode=TwoWay}" />
                <TextBlock Style="{StaticResource OptionHintStyle}" Text="Bağlantı koptuğunda cihaza yeniden bağlanmayı dener." />

                <Rectangle Style="{StaticResource DividerHorizontalStyle}" Margin="0,40" />

                <!-- GİRDİ -->
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Girdi" />

                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="FN tuşu numarası" />
                <TextBox Style="{StaticResource InputTextBoxStyle}" HorizontalAlignment="Left" Width="160"
                         Text="{Binding FnKeyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{Binding FnKeyError}" AutomationProperties.Name="FN tuşu numarası" />
                <TextBlock Style="{StaticResource FieldErrorStyle}" Text="{Binding FnKeyError}" />

                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Uzun basma süresi (ms)" Margin="0,24,0,8" />
                <TextBox Style="{StaticResource InputTextBoxStyle}" HorizontalAlignment="Left" Width="160"
                         Text="{Binding LongPressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{Binding LongPressError}" AutomationProperties.Name="Uzun basma süresi" />
                <TextBlock Style="{StaticResource FieldErrorStyle}" Text="{Binding LongPressError}" />

                <TextBlock Style="{StaticResource TextBodyStrong}" Margin="0,32,0,4" Text="FN + tuş ile profil değiştir" />
                <TextBlock Style="{StaticResource TextCaptionMuted}" Margin="0,0,0,16" TextWrapping="Wrap" TextTrimming="None"
                           Text="FN tuşuna basılıyken seçilen tuşa basılınca ilgili profil etkinleşir." />

                <TextBlock Style="{StaticResource EmptyMappingsStyle}" Text="Henüz eşleştirme yok." />

                <ItemsControl ItemsSource="{Binding FnMappings}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Style="{StaticResource InputTextBoxStyle}" Width="96"
                                             Text="{Binding KeyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="{Binding Error}" ToolTip="Tuş numarası"
                                             AutomationProperties.Name="Tuş numarası" />
                                    <ComboBox Style="{StaticResource InputComboBoxStyle}" Width="240" Margin="12,0,0,0"
                                              ItemsSource="{Binding DataContext.ProfileOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding ProfileId, Mode=TwoWay}"
                                              Tag="{Binding Error}" AutomationProperties.Name="Profil">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Style="{StaticResource IconButtonStyle}" Tag="{StaticResource IconClose}"
                                            ToolTip="Satırı sil" AutomationProperties.Name="Satırı sil"
                                            Command="{Binding RemoveCommand}" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource FieldErrorStyle}" Text="{Binding Error}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Eşleştirme ekle"
                        HorizontalAlignment="Left" Margin="0,4,0,0"
                        Command="{Binding AddRowCommand}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
