<UserControl x:Class="SipoDeck.Views.KeysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SipoDeck.ViewModels"
             Focusable="False">
    <UserControl.Resources>
        <!-- Katalog tabanlı eylem editörü: tür seçimi, parametre formu ve zincir için makro adımları (iç içe kullanılır) -->
        <DataTemplate DataType="{x:Type vm:ActionEditorViewModel}">
            <StackPanel>
                <ComboBox Style="{StaticResource InputComboBoxStyle}" ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedType}" DisplayMemberPath="Display" />

                <Border Margin="0,8,0,0" Padding="10,8" CornerRadius="4" BorderThickness="1"
                        BorderBrush="{StaticResource BorderStrongBrush}" Background="{StaticResource SurfaceElevatedBrush}"
                        Visibility="{Binding Warning, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock Text="{Binding Warning}" Style="{StaticResource TextBodySmallStrong}" TextWrapping="Wrap" />
                </Border>

                <ItemsControl ItemsSource="{Binding Parameters}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="{Binding Label}" Style="{StaticResource TextBodySmall}" />
                                <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding IsPlainText, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                                         Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="12,8"
                                         VerticalScrollBarVisibility="Auto"
                                         Visibility="{Binding IsLongText, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Grid Visibility="{Binding IsFilePath, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Gözat" Margin="6,0,0,0"
                                            Command="{Binding BrowseFileCommand}"
                                            Visibility="{Binding CanBrowseFile, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Content="Klasör" Margin="6,0,0,0"
                                            Command="{Binding BrowseFolderCommand}"
                                            Visibility="{Binding CanBrowseFolder, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                                <ComboBox Style="{StaticResource InputComboBoxStyle}" ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" DisplayMemberPath="Label"
                                          Visibility="{Binding IsChoice, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <ComboBox Style="{StaticResource InputComboBoxStyle}" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name"
                                          Visibility="{Binding IsProfile, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock Text="{Binding Error}" Foreground="#E5484D" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Visibility="{Binding Error, Converter={StaticResource NullToVisibilityConverter}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding ValidationSummary}" Foreground="#E5484D" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding ValidationSummary, Converter={StaticResource NullToVisibilityConverter}}" />

                <!-- Makro düzenleyici (yalnızca zincir türü) -->
                <StackPanel Margin="0,10,0,0" Visibility="{Binding IsChain, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Makro adımları" Style="{StaticResource TextBodyStrong}" />
                    <TextBlock Text="{Binding ChainSummary}" Style="{StaticResource TextCaptionMuted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StepLimitMessage}" Foreground="#E5484D" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding StepLimitMessage, Converter={StaticResource NullToVisibilityConverter}}" />

                    <ItemsControl ItemsSource="{Binding Steps}" Focusable="False" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,6" Padding="8">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding StepTitle}" Style="{StaticResource TextBodySmallStrong}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="↑" ToolTip="Yukarı taşı" Margin="0,0,4,0"
                                                        Command="{Binding DataContext.MoveStepUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="↓" ToolTip="Aşağı taşı" Margin="0,0,4,0"
                                                        Command="{Binding DataContext.MoveStepDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Kopyala" Margin="0,0,4,0"
                                                        Command="{Binding DataContext.DuplicateStepCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Sil"
                                                        Command="{Binding DataContext.RemoveStepCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                        <ContentControl Content="{Binding}" Focusable="False" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Style="{StaticResource InputComboBoxStyle}" ItemsSource="{Binding StepTypeOptions}" SelectedItem="{Binding NewStepType}" DisplayMemberPath="Display" />
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Adım ekle" Margin="6,0,0,0" Command="{Binding AddStepCommand}" />
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Content="Bekleme ekle" Margin="6,0,0,0" Command="{Binding AddWaitCommand}" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Tuş Düzeni ve Atama" Style="{StaticResource TextTitle3}" Margin="0,0,0,12" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="Cihaz Tuşları" Style="{StaticResource TextBodyStrong}" Margin="0,0,0,8" />
                    <TextBlock Text="Tuş bilgisi için cihazın bağlanması gerekir." Style="{StaticResource TextCaptionMuted}" Margin="0,0,0,8"
                               Visibility="{Binding HasNoKeys, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <ItemsControl ItemsSource="{Binding Keys}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding DataContext.GridCols, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             Rows="{Binding DataContext.GridRows, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="4" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource TextBodyStrong}" />
                                        <TextBlock Text="FN tuşu" Visibility="{Binding IsFnKey, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource TextCaptionMuted}" />
                                        <TextBlock Text="Normal eylem var" Visibility="{Binding Action, Converter={StaticResource NullToVisibilityConverter}}" Style="{StaticResource TextCaptionMuted}" />
                                        <TextBlock Text="Uzun basma var" Visibility="{Binding LongPressAction, Converter={StaticResource NullToVisibilityConverter}}" Style="{StaticResource TextCaptionMuted}" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Seç" Margin="0,6,0,0"
                                                Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="{Binding InterceptionButtonText}" Command="{Binding ToggleInterceptionCommand}" Margin="0,16,0,0" HorizontalAlignment="Left" />

                    <TextBlock Text="Kombinasyonlar" Style="{StaticResource TextBodyStrong}" Margin="0,24,0,8" />
                    <ItemsControl ItemsSource="{Binding Combinations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="Tuşlar (virgülle ayırın, en az 2)" Style="{StaticResource TextBodySmall}" />
                                        <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding KeysString, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8" />
                                        <ContentControl Content="{Binding ActionEditor}" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Sil" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                Command="{Binding DataContext.DeleteCombinationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="Yeni Kombinasyon Ekle" Command="{Binding AddCombinationCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Padding="16,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Seçili Tuş" Style="{StaticResource TextBodyStrong}" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding SelectedKey.Label, FallbackValue='(Tuş seçilmedi)'}" Style="{StaticResource TextBody}" Margin="0,0,0,12" />

                        <StackPanel Visibility="{Binding IsKeySelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="FN tuşuna tekli eylem atanamaz." Style="{StaticResource TextCaptionMuted}" Margin="0,0,0,8"
                                       Visibility="{Binding SelectedKey.IsFnKey, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <StackPanel IsEnabled="{Binding SelectedKey.CanAssign}">
                                <TextBlock Text="Normal eylem (tuş bırakılınca)" Style="{StaticResource TextBodyStrong}" Margin="0,0,0,6" />
                                <ContentControl Content="{Binding SelectedKey.ActionEditor}" />
                                <TextBlock Text="Uzun basma eylemi" Style="{StaticResource TextBodyStrong}" Margin="0,16,0,6" />
                                <ContentControl Content="{Binding SelectedKey.LongPressEditor}" />
                            </StackPanel>

                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="Atamayı Temizle" Command="{Binding ClearKeyCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" />

                            <TextBlock Text="Atamayı kopyala" Style="{StaticResource TextBodyStrong}" Margin="0,16,0,6" />
                            <ComboBox Style="{StaticResource InputComboBoxStyle}" ItemsSource="{Binding Keys}" SelectedItem="{Binding CopyTarget}" DisplayMemberPath="Label" />
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="Kopyala" Command="{Binding CopyKeyCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Style="{StaticResource PrimaryButtonStyle}" Content="Kaydet" Command="{Binding SaveCommand}" Margin="0,0,8,0" />
            <Button Style="{StaticResource SecondaryButtonStyle}" Content="İptal" Command="{Binding CancelCommand}" />
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource TextBodySmall}" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
