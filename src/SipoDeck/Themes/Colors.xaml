<!--
    SipoDeck — Renk kaynakları (monokrom).
    Kaynak: docs/design/ui-design-brief.md, docs/design/design-system.md §2.

    Adlandırma: <Ad>Color (System.Windows.Media.Color) ve <Ad>Brush (SolidColorBrush).
    Kural: Renkli ton YOK. Ara tonlar yalnızca gri skala. Gradient yalnızca
    siyah → şeffaf siyah maske olarak (Mask* fırçaları).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ Brief renkleri ============ -->
    <Color x:Key="BgBaseColor">#FF050505</Color>
    <Color x:Key="SurfaceSecondaryColor">#FF0D0D0D</Color>
    <Color x:Key="SurfaceElevatedColor">#FF141414</Color>
    <Color x:Key="BorderColor">#FF272727</Color>
    <Color x:Key="TextPrimaryColor">#FFFFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#FF8C8C8C</Color>
    <Color x:Key="TextMutedColor">#FF5F5F5F</Color>
    <Color x:Key="SelectionBgColor">#FFFFFFFF</Color>
    <Color x:Key="SelectionFgColor">#FF050505</Color>

    <!-- ============ Ara tonlar (gri skala) ============ -->
    <Color x:Key="SurfaceHoverColor">#FF1A1A1A</Color>
    <Color x:Key="SurfacePressedColor">#FF202020</Color>
    <Color x:Key="BorderSubtleColor">#FF1A1A1A</Color>
    <Color x:Key="BorderStrongColor">#FF3D3D3D</Color>
    <Color x:Key="TextDisabledColor">#FF3D3D3D</Color>
    <Color x:Key="PrimaryHoverColor">#FFE8E8E8</Color>
    <Color x:Key="PrimaryPressedColor">#FFD2D2D2</Color>
    <Color x:Key="ScrollThumbColor">#FF2E2E2E</Color>
    <Color x:Key="ScrollThumbHoverColor">#FF505050</Color>
    <Color x:Key="GaugeTrackColor">#FF262626</Color>
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="BgBaseTransparentColor">#00050505</Color>

    <!-- Cihaz görseli (DeviceVisual.xaml) tonları -->
    <Color x:Key="DeviceBodyColor">#FF0E0E0E</Color>
    <Color x:Key="DeviceBodyEdgeColor">#FF242424</Color>
    <Color x:Key="DeviceKeyFaceColor">#FF171717</Color>
    <Color x:Key="DeviceKeyFaceHoverColor">#FF1E1E1E</Color>
    <Color x:Key="DeviceKeySideColor">#FF080808</Color>
    <Color x:Key="DeviceKeyEdgeColor">#FF2B2B2B</Color>
    <Color x:Key="DeviceRimLightColor">#1FFFFFFF</Color>
    <Color x:Key="DeviceKeyHighlightColor">#12FFFFFF</Color>
    <Color x:Key="StageLightColor">#FF161616</Color>

    <!-- ============ Fırçalar ============ -->
    <SolidColorBrush x:Key="BgBaseBrush" Color="{StaticResource BgBaseColor}" />
    <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="{StaticResource SurfaceSecondaryColor}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="SelectionBgBrush" Color="{StaticResource SelectionBgColor}" />
    <SolidColorBrush x:Key="SelectionFgBrush" Color="{StaticResource SelectionFgColor}" />

    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="{StaticResource SurfacePressedColor}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbColor}" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="{StaticResource ScrollThumbHoverColor}" />
    <SolidColorBrush x:Key="GaugeTrackBrush" Color="{StaticResource GaugeTrackColor}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource BlackColor}" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="{StaticResource TextPrimaryColor}" Opacity="0.9" />
    <SolidColorBrush x:Key="TransparentBrush" Color="{StaticResource BgBaseTransparentColor}" />

    <SolidColorBrush x:Key="DeviceBodyBrush" Color="{StaticResource DeviceBodyColor}" />
    <SolidColorBrush x:Key="DeviceBodyEdgeBrush" Color="{StaticResource DeviceBodyEdgeColor}" />
    <SolidColorBrush x:Key="DeviceKeyFaceBrush" Color="{StaticResource DeviceKeyFaceColor}" />
    <SolidColorBrush x:Key="DeviceKeyFaceHoverBrush" Color="{StaticResource DeviceKeyFaceHoverColor}" />
    <SolidColorBrush x:Key="DeviceKeySideBrush" Color="{StaticResource DeviceKeySideColor}" />
    <SolidColorBrush x:Key="DeviceKeyEdgeBrush" Color="{StaticResource DeviceKeyEdgeColor}" />
    <SolidColorBrush x:Key="DeviceRimLightBrush" Color="{StaticResource DeviceRimLightColor}" />
    <SolidColorBrush x:Key="DeviceKeyHighlightBrush" Color="{StaticResource DeviceKeyHighlightColor}" />
    <SolidColorBrush x:Key="StageLightBrush" Color="{StaticResource StageLightColor}" />

    <!-- ============ Siyah → şeffaf siyah maskeler (izin verilen tek gradient türü) ============ -->
    <!-- Üstten aşağı: üst kenar koyu, aşağı doğru şeffaf. Video üstü / başlık çubuğu okunurluğu. -->
    <LinearGradientBrush x:Key="MaskFadeFromTopBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#E6050505" />
        <GradientStop Offset="0.45" Color="#66050505" />
        <GradientStop Offset="1" Color="#00050505" />
    </LinearGradientBrush>

    <!-- Aşağıdan yukarı: alt kenar tam koyu, yukarı doğru şeffaf. Video altı / metin zemini. -->
    <LinearGradientBrush x:Key="MaskFadeFromBottomBrush" StartPoint="0,1" EndPoint="0,0">
        <GradientStop Offset="0" Color="#FF050505" />
        <GradientStop Offset="0.35" Color="#D9050505" />
        <GradientStop Offset="0.7" Color="#4D050505" />
        <GradientStop Offset="1" Color="#00050505" />
    </LinearGradientBrush>

    <!-- Kenar karartma (vinyet): merkez şeffaf, kenarlar koyu. Yer tutucu sahne ve cihaz sahnesi. -->
    <RadialGradientBrush x:Key="MaskVignetteBrush" Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.75" RadiusY="0.8">
        <GradientStop Offset="0" Color="#00050505" />
        <GradientStop Offset="0.55" Color="#00050505" />
        <GradientStop Offset="1" Color="#FF050505" />
    </RadialGradientBrush>

    <!-- Cihaz gövdesinin alt yarısını karartan maske (monokrom derinlik). -->
    <LinearGradientBrush x:Key="MaskDeviceShadeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#00000000" />
        <GradientStop Offset="0.5" Color="#00000000" />
        <GradientStop Offset="1" Color="#8C000000" />
    </LinearGradientBrush>

</ResourceDictionary>
