<!--
    SipoDeck — Renksiz durum göstergeleri.
    Kaynak: ui-design-brief.md "Durumlar renk kullanılmadan ifade edilir", design-system.md §11.

    Tek kullanım biçimi (.cs gerektirmez): durum değeri Tag'e verilir.
        <Control Style="{StaticResource StatusIndicatorStyle}" Tag="{Binding ConnectionState}" />
        <ContentControl Style="{StaticResource StatusLabelStyle}" Tag="{Binding ConnectionState}" Content="Bağlı" />

    Tag string ya da enum olabilir (DataTrigger, değeri enum adına dönüştürerek karşılaştırır).
    Tanınan değerler:
        Dolu beyaz nokta        : Connected, Running
        İçi boş beyaz nokta     : Waiting, Connecting   (ve tanınmayan/boş değer — varsayılan)
        Çapraz çizgili nokta    : Disconnected, Error, Stopped, Faulted
        Dönen ince beyaz halka  : Busy, Starting, Stopping   (YALNIZCA bu durumda döner)
    Bunlar SipoDeck.Core.Transport.ConnectionState ve SipoDeck.Runtime.RuntimeState adlarıyla birebir uyumludur.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SipoDeck;component/Themes/Colors.xaml" />
        <ResourceDictionary Source="/SipoDeck;component/Themes/Motion.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="StatusIndicatorStyle" TargetType="Control">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <ControlTemplate.Resources>
                        <Storyboard x:Key="SpinStoryboard">
                            <DoubleAnimation Storyboard.TargetName="Busy"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                             From="0" To="360"
                                             Duration="{StaticResource DurationSpin}"
                                             RepeatBehavior="Forever" />
                        </Storyboard>
                    </ControlTemplate.Resources>

                    <Grid>
                        <!-- Bağlı: dolu beyaz nokta -->
                        <Ellipse x:Name="Filled" Width="8" Height="8" Visibility="Collapsed"
                                 Fill="{StaticResource TextPrimaryBrush}" />

                        <!-- Bekliyor: içi boş beyaz nokta (varsayılan) -->
                        <Ellipse x:Name="Hollow" Width="8" Height="8"
                                 Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.25" />

                        <!-- Bağlantı yok: çapraz çizgili nokta -->
                        <Grid x:Name="Crossed" Width="10" Height="10" Visibility="Collapsed">
                            <Ellipse Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.25" />
                            <Path Data="M2.1,7.9 L7.9,2.1"
                                  Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.25"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>

                        <!-- İşlem sürüyor: dönen ince beyaz halka -->
                        <Grid x:Name="Busy" Width="12" Height="12" Visibility="Collapsed"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <RotateTransform Angle="0" />
                            </Grid.RenderTransform>
                            <Ellipse Stroke="{StaticResource GaugeTrackBrush}" StrokeThickness="1.5" />
                            <Path Data="M6,0.75 A5.25,5.25 0 0 1 11.25,6"
                                  Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>
                    </Grid>


                    <ControlTemplate.Triggers>
                        <!-- Dolu -->
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Connected">
                            <Setter TargetName="Hollow" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Filled" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Running">
                            <Setter TargetName="Hollow" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Filled" Property="Visibility" Value="Visible" />
                        </DataTrigger>

                        <!-- Çapraz çizgili -->
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Disconnected">
                            <Setter TargetName="Hollow" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Crossed" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Error">
                            <Setter TargetName="Hollow" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Crossed" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Stopped">
                            <Setter TargetName="Hollow" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Crossed" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Faulted">
                            <Setter TargetName="Hollow" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Crossed" Property="Visibility" Value="Visible" />
                        </DataTrigger>

                        <!-- Dönen halka (yalnızca bu durumlarda animasyon çalışır) -->
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Busy">
                            <Setter TargetName="Hollow" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Busy" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="SpinBusy" Storyboard="{StaticResource SpinStoryboard}" />
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="SpinBusy" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Starting">
                            <Setter TargetName="Hollow" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Busy" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="SpinStarting" Storyboard="{StaticResource SpinStoryboard}" />
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="SpinStarting" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Stopping">
                            <Setter TargetName="Hollow" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Busy" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="SpinStopping" Storyboard="{StaticResource SpinStoryboard}" />
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="SpinStopping" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Gösterge + metin. Metin Body (14) varsayılanı; Foreground üst öğeden miras alınır. -->
    <Style x:Key="StatusLabelStyle" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <StackPanel Orientation="Horizontal">
                        <Control Style="{StaticResource StatusIndicatorStyle}"
                                 Tag="{TemplateBinding Tag}" VerticalAlignment="Center" />
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
