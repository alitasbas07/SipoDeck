    <!-- ============ İkon sunum stilleri ============ -->
    <!--
        ContentControl.Content = Geometry kaynağı. Foreground miras alınır (Style Foreground AYARLAMAZ).
        StrokeThickness = 1.5 × 24 / boyut → görünen çizgi her boyutta ≈ 1.5 px.
    -->
    <Style x:Key="IconBase" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Tag" Value="1.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Viewbox Stretch="Uniform">
                        <Path Width="24" Height="24" Stretch="None"
                              Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                              Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Icon24" TargetType="ContentControl" BasedOn="{StaticResource IconBase}" />

    <Style x:Key="Icon20" TargetType="ContentControl" BasedOn="{StaticResource IconBase}">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Tag" Value="1.8" />
    </Style>

    <Style x:Key="Icon16" TargetType="ContentControl" BasedOn="{StaticResource IconBase}">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Tag" Value="2.25" />
    </Style>

    <Style x:Key="IconLogoBase" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Content" Value="{StaticResource IconLogo}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Viewbox Stretch="Uniform">
                        <Path Width="24" Height="24" Stretch="None"
                              Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                              Fill="{TemplateBinding Foreground}" />
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconLogo16" TargetType="ContentControl" BasedOn="{StaticResource IconLogoBase}">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>

    <Style x:Key="IconLogo20" TargetType="ContentControl" BasedOn="{StaticResource IconLogoBase}">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
    </Style>

</ResourceDictionary>
